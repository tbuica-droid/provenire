# ─────────────────────────────────────────────────────────────────────────────
# Provenire (provenire) — local environment configuration
# Copy this file to `.env` and fill in your key:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — your Anthropic API key. Get one at https://console.anthropic.com/
# This is the only credential the app needs to run the analysis + memo pipeline.
ANTHROPIC_API_KEY=

# OPTIONAL — model used for findings extraction and memo assembly.
# Defaults to the most capable model. Set to claude-sonnet-4-6 for faster/cheaper demos.
PROVENIRE_ANALYSIS_MODEL=claude-opus-4-8

# OPTIONAL — thinking depth for the analysis calls: "adaptive" (default) or "off".
PROVENIRE_THINKING=adaptive

# OPTIONAL — effort for the analysis calls: low | medium | high (default) | max
PROVENIRE_EFFORT=high

# OPTIONAL — retrieval embedder:
#   "lexical" (default) — deterministic TF-IDF, no downloads, works fully offline.
#   "local"             — semantic embeddings via @xenova/transformers (all-MiniLM-L6-v2).
#                         Requires `npm i @xenova/transformers`; first run downloads ~90MB.
PROVENIRE_EMBEDDER=lexical

# OPTIONAL — number of chunks retrieved per category per analysis call.
PROVENIRE_RETRIEVAL_K=14
